{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "coordinatez-axis-demo",
  "main": "./dist/server/index.js",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist/client"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "coordinatez-axis-demo-db",
      "database_id": "08b52441-971a-41ed-a2cd-07d1c0df5a8c",
      "migrations_dir": "./drizzle"
    }
  ],
  "observability": {
    "enabled": true
  }
}
